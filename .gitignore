# compiled output (made by build.sh)
/starkindle
/starkindle.bak-*
/assets/js/
/node_modules/
# deploy scripts stay off GitHub (server layout)
/deploy/

# Previous, staged and failed builds kept beside the running one
/starkindle.*

# Never commit: databases, cookie jars, keys
*.db
*.db-*
*.sqlite*
*jar.txt
.env*
*.pem
*.key
